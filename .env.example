# ==========================================
# GeoQuest / GeoGuessr Environment Variables
# (All tools have 100% Free Tiers)
# ==========================================

# 1. Mapillary Graph API Client Token (Free from mapillary.com / Facebook Developer)
# Optional: If left blank, the game seamlessly uses high-resolution curated 360 photospheres!
VITE_MAPILLARY_CLIENT_TOKEN=

# 2. Supabase Free Tier (Auth, DB, Leaderboards)
# Optional: If left blank, runs in local offline guest mode with full persistence!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Groq API Free Tier (High-speed Llama 3.1 for AI Clues & Trivia Rewrites)
# Optional: If left blank, uses curated progressive clues automatically!
VITE_GROQ_API_KEY=
